# -----------------------------------------------------------------------------
# Python bytecode and interpreter artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python

# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.envdir/

# The optional PaddleOCR-VL runtime is a separate, locally installed environment.
# Keep the worker source file at the project root; ignore only its runtime folder.
/vl_runtime/

# -----------------------------------------------------------------------------
# Secrets and local environment settings
# Keep .env.example (with placeholder values) versioned when needed.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
.secrets/
secrets/
credentials/
credentials.json
service-account*.json
*-credentials.json
config.local.json
*.secret
*.secret.*
*.pem
*.key
*.p12
*.pfx
*.crt
.netrc
.pypirc

# -----------------------------------------------------------------------------
# Local Python packaging and build output
# -----------------------------------------------------------------------------
build/
dist/
.eggs/
*.egg
*.egg-info/
*.whl
pip-wheel-metadata/
.installed.cfg

# -----------------------------------------------------------------------------
# Test, coverage, type-checker, and linter caches
# -----------------------------------------------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
junit.xml
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/
.hypothesis/

# -----------------------------------------------------------------------------
# Editors and operating systems
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Machine-learning checkpoints and exported models
# The application can download its configured checkpoint from Hugging Face if the
# local checkpoint is absent. Store large/private model weights outside Git or use
# Git LFS when the project requires versioning them.
# -----------------------------------------------------------------------------
/models/*.pt
/models/*.pth
/models/*.ckpt
/models/*.onnx
/models/*.engine
/models/*.tflite
/models/*.pb
/models/*.safetensors
/models/*.bin
/models/*.weights
/models/*.mlmodel
/models/*.gguf
!/models/.gitkeep

# -----------------------------------------------------------------------------
# Model, OCR, and experiment caches / generated training runs
# -----------------------------------------------------------------------------
.cache/
.cache-*/
.ultralytics/
.paddleocr/
.paddlex/
*.cache
runs/
wandb/
mlruns/
tensorboard/
lightning_logs/

# -----------------------------------------------------------------------------
# Gradio temporary data and local application outputs
# -----------------------------------------------------------------------------
flagged/
grgradio/
tmp/
temp/
/tmp/
/outputs/
/output/
/artifacts/
/logs/
*.log

# Annotated images and intermediate OCR crops generated while debugging
annotated_images/
debug_images/
ocr_debug/
ocr_crops/
crops/
*_annotated.jpg
*_annotated.jpeg
*_annotated.png
*_annotated.webp
annotated_*.jpg
annotated_*.jpeg
annotated_*.png
annotated_*.webp

# -----------------------------------------------------------------------------
# Sensitive licence data and generated extraction reports
# These can contain names, dates of birth, addresses, and licence numbers.
# Do not ignore config.json: it is part of the application's configuration.
# -----------------------------------------------------------------------------
/detected_license.json
/detected_license_*.json
/detected_licence.json
/detected_licence_*.json
/vl_result.json
/ocr_result*.json
/extracted_licence*.json
/extracted_license*.json
/validation_report*.json

# Optional sample folder: keep only its placeholder/documentation by default.
# Add vetted synthetic or public samples explicitly if you intend to share them.
/samples/*
!/samples/.gitkeep
!/samples/README.md

# -----------------------------------------------------------------------------
# Temporary files and patch backups
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.old
*.swp
*.swo
app_runtime/